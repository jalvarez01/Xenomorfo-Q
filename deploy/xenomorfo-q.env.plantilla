# Variables del servicio xenomorfo-q (D18). deploy/instalar.sh copia esta plantilla a
# /etc/xenomorfo-q.env (dueño root:xq, permisos 600) solo si ese archivo no existe.
# Complétalo en el servidor con: sudo nano /etc/xenomorfo-q.env
# Después: sudo systemctl restart xenomorfo-q
#
# Nunca copies el archivo completo en el repositorio, en un chat ni en una captura.

# Proveedor del modelo: openai (recomendado) o nvidia.
XQ_PROVEEDOR=
# Clave de OpenAI (si XQ_PROVEEDOR=openai).
OPENAI_API_KEY=
# Clave de NVIDIA (si XQ_PROVEEDOR=nvidia).
NVIDIA_API_KEY=
# Cupos del chat; vacío usa 20 por sesión y 60 por hora en todo el servidor.
XQ_PANEL_MAX_SESION=
XQ_PANEL_MAX_HORA=
