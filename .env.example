# Copia este archivo como .env (no se sube al repositorio) y completa la clave del proveedor.
# Proveedor del modelo: openai (por defecto) o nvidia (NVIDIA NIM, alternativa gratuita).
XQ_PROVEEDOR=openai
# Clave de OpenAI, para XQ_PROVEEDOR=openai. Nunca la subas al repositorio.
OPENAI_API_KEY=
# Clave de NVIDIA NIM (build.nvidia.com), para XQ_PROVEEDOR=nvidia. Nunca la subas al repositorio.
NVIDIA_API_KEY=
# Modelo. Vacío usa el del proveedor: gpt-5.4-nano con openai, openai/gpt-oss-20b con nvidia.
# Ejemplos: XQ_MODELO=gpt-5.4-mini (openai) o XQ_MODELO=openai/gpt-oss-20b (nvidia).
XQ_MODELO=
# URL base de un backend compatible con OpenAI. Vacío usa la del proveedor.
XQ_URL_BASE=
# Temperatura de muestreo; 0 hace repetibles los casos de prueba.
XQ_TEMPERATURA=0
