# Copia este archivo como .env (no se sube al repositorio) y completa la clave.
# Clave de la API de NVIDIA. Obligatoria para usar el LLM real; nunca la subas al repositorio.
NVIDIA_API_KEY=
# Nombre del modelo en el backend.
XQ_MODELO=meta/llama-3.3-70b-instruct
# URL base de un backend compatible con OpenAI; cámbiala para usar otro proveedor.
XQ_URL_BASE=https://integrate.api.nvidia.com/v1
# Temperatura de muestreo; 0 hace repetibles los casos de prueba.
XQ_TEMPERATURA=0
