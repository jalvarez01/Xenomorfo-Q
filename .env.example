# Proveedor del modelo: openai (por defecto) o nvidia
XQ_PROVEEDOR=openai

# Clave de OpenAI (obligatoria con XQ_PROVEEDOR=openai)
OPENAI_API_KEY=

# Clave de NVIDIA NIM (solo si cambias a XQ_PROVEEDOR=nvidia)
NVIDIA_API_KEY=""


# Vacíos: usan los valores por defecto del proveedor
XQ_MODELO=gpt-5.4-nano
XQ_URL_BASE=

# Temperatura 0 para respuestas repetibles
XQ_TEMPERATURA=0